# Postgres for the pastebin and Google sign-in — every other tool works without it.
# Use the Supabase pooler connection string (Project settings → Database).
DATABASE_URL=postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Session signing secret — any long random string (e.g. `openssl rand -hex 32`).
BETTER_AUTH_SECRET=generate-a-long-random-string
# Public base URL of the deployment — OAuth redirects resolve against it.
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client with redirect URI <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Request size limit for file conversions.
MAX_UPLOAD_MB=512
# Max file size for yt-dlp downloads, 0 = no limit.
MAX_DOWNLOAD_MB=0
PASTE_MAX_KB=256
# Set 1 behind a reverse proxy so per-IP rate limits read x-forwarded-for.
TRUST_PROXY=0

# Optional overrides:
# PORT=3000
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# YTDLP_PATH=/usr/local/bin/yt-dlp
# BSDTAR_PATH=/usr/bin/bsdtar
# CHROMIUM_PATH=/usr/bin/chromium
# CHROMIUM_NO_SANDBOX=1 when Chromium runs as root (Docker)
